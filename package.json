{
    "name": "dusome-pygame",
    "displayName": "Dusome PyGame",
    "description": "A VS Code extension to generate a PyGame setup for Mr. Dusome's class.",
    "version": "2.0.0",
    "publisher": "Dusome",
    "engines": {
        "vscode": "^1.50.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.showPygameMenu",
                "title": "PyGame: Show Menu",
                "icon": "$(game)"
            },
            {
                "command": "extension.createPyGameProject",
                "title": "PyGame: Create Project"
            },
            {
                "command": "extension.addPyGameButtonSupport",
                "title": "PyGame: Add Button Object From The Web"
            },
            {
                "command": "extension.addPyGameTextInputSupport",
                "title": "PyGame: Add Text Input Object From The Web"
            },
            {
                "command": "extension.addPyGameGridSupport",
                "title": "PyGame: Add Grid Object From The Web"
            },
            {
                "command": "extension.addPyGameImageSupport",
                "title": "PyGame: Add Image Object From The Web"
            },
            {
                "command": "extension.addPyGameDBSupport",
                "title": "PyGame: Add DB Objects From the Web"
            },
            {
                "command": "extension.disposablePyGameCheck",
                "title": "Add CheckBox and Radio Buttons From the Web"
            },
            {
                "command": "extension.disposablePyGameListwidget",
                "title": "PyGame: Add List Widget and Combobox From the Web"
            },
            {
                "command": "extension.disposablePyGameText",
                "title": "PyGame: Add Text file from Web"
            },
            {
                "command": "extension.disposablePyGameRun",
                "title": "PyGame: Run Program"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "extension.createPyGameProject",
                    "when": "explorerResourceIsFolder",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "extension.showPygameMenu",
                    "group": "navigation",
                    "title": "$(game) PyGame Actions",
                    "tooltip": "Open PyGame Actions Menu"
                }
            ],
            "editor/context": [
                {
                    "command": "extension.disposablePyGameRun",
                    "category": "python",
                    "title": "PyGame: Run Program",
                    "group": "navigation"
                },
                {
                    "command": "extension.showPygameMenu",
                    "when": "resourceLangId == python",
                    "group": "navigation",
                    "title": "PyGame Actions"
                }
            ]
        },
        "configuration": {
            "title": "PyGame Objects",
            "properties": {
                "pygameObjects.baseUrl": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/Mathew-D/pygame-objects/main/",
                    "description": "Base URL for downloading pygame objects. Must end with a forward slash.",
                    "scope": "application"
                },
                "pygameObjects.objectsFolder": {
                    "type": "string",
                    "default": "objects",
                    "description": "Folder name where downloaded objects will be saved.",
                    "scope": "application"
                },
                "pygameObjects.defaultFPS": {
                    "type": "number",
                    "default": 60,
                    "description": "Default FPS for new PyGame projects.",
                    "scope": "application"
                },
                "pygameObjects.defaultWindowWidth": {
                    "type": "number",
                    "default": 500,
                    "description": "Default window width for new PyGame projects.",
                    "scope": "application"
                },
                "pygameObjects.defaultWindowHeight": {
                    "type": "number",
                    "default": 500,
                    "description": "Default window height for new PyGame projects.",
                    "scope": "application"
                },
                "pygameObjects.defaultAuthorName": {
                    "type": "string",
                    "default": "<Your Name Here>",
                    "description": "Default author name for new PyGame projects. Leave empty to use 'Your Name Here'.",
                    "scope": "application"
                },
                "pygameObjects.autoOpenDownloadedFiles": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically open downloaded files in the editor.",
                    "scope": "application"
                }
            }
        }
    },
    "files": [
        "extension.js"
    ],
    "scripts": {
        "package": "vsce package",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mathew-D/vs_code_pygame"
    },
    "keywords": [
        "vscode",
        "extension",
        "python",
        "pygame"
    ],
    "author": "Mathew Dusome",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.5.4"
    }
}