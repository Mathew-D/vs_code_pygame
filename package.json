{
    "name": "dusome-pygame",
    "displayName": "Dusome PyGame",
    "description": "A VS Code extension to generate a PyGame setup for Mr. Dusome's class.",
    "version": "2.0.0",
    "publisher": "Dusome",
    "engines": {
        "vscode": "^1.50.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.showPygameMenu",
                "title": "PyGame: Show Menu",
                "icon": "$(game)"
            },
            {
                "command": "extension.createPyGameProject",
                "title": "PyGame: Create Project"
            },
            {
                "command": "extension.disposablePyGameRun",
                "title": "PyGame: Run Program"
            },
            {
                "command": "extension.addConfiguredPyGameModule",
                "title": "PyGame: Add Configured Module From The Web"
            },
            {
                "command": "extension.manageSettings",
                "title": "PyGame: Manage Settings"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "extension.createPyGameProject",
                    "when": "explorerResourceIsFolder",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "extension.showPygameMenu",
                    "group": "navigation",
                    "title": "$(game) PyGame Actions",
                    "tooltip": "Open PyGame Actions Menu"
                }
            ],
            "editor/context": [
                {
                    "command": "extension.disposablePyGameRun",
                    "category": "python",
                    "title": "PyGame: Run Program",
                    "group": "navigation"
                },
                {
                    "command": "extension.showPygameMenu",
                    "when": "resourceLangId == python",
                    "group": "navigation",
                    "title": "PyGame Actions"
                }
            ]
        },
        "configuration": {
            "title": "PyGame Objects",
            "properties": {
                "pygameObjects.baseUrl": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/Mathew-D/pygame-objects/main/",
                    "description": "Base URL for downloading pygame objects. Must end with a forward slash.",
                    "scope": "application"
                },
                "pygameObjects.objectsFolder": {
                    "type": "string",
                    "default": "objects",
                    "description": "Folder name where downloaded objects will be saved.",
                    "scope": "application"
                },
                "pygameObjects.defaultFPS": {
                    "type": "number",
                    "default": 60,
                    "description": "Default FPS for new PyGame projects.",
                    "scope": "application"
                },
                "pygameObjects.defaultWindowWidth": {
                    "type": "number",
                    "default": 500,
                    "description": "Default window width for new PyGame projects.",
                    "scope": "application"
                },
                "pygameObjects.defaultWindowHeight": {
                    "type": "number",
                    "default": 500,
                    "description": "Default window height for new PyGame projects.",
                    "scope": "application"
                },
                "pygameObjects.defaultAuthorName": {
                    "type": "string",
                    "default": "<Your Name Here>",
                    "description": "Default author name for new PyGame projects. Leave empty to use 'Your Name Here'.",
                    "scope": "application"
                },
                "pygameObjects.autoOpenDownloadedFiles": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically open downloaded files in the editor.",
                    "scope": "application"
                },
                "pygameObjects.downloadItems": {
                    "type": "array",
                    "default": [
                        {
                            "fileName": "buttons.py",
                            "menuLabel": "Add Button Object From The Web",
                            "successMessage": "Adding Button Object"
                        },
                        {
                            "fileName": "list_widget.py",
                            "menuLabel": "Add List Widget and Combobox From The Web",
                            "successMessage": "Adding List Widget and Combobox"
                        },
                        {
                            "fileName": "grid.py",
                            "menuLabel": "Add Grid Object From The Web",
                            "successMessage": "Adding Grid Object"
                        },
                        {
                            "fileName": "image.py",
                            "menuLabel": "Add Image Object From The Web",
                            "successMessage": "Adding Image Object"
                        },
                        {
                            "fileName": "label.py",
                            "menuLabel": "Add Label Object From The Web",
                            "successMessage": "Adding Label Object"
                        },
                        {
                            "fileName": "text.py",
                            "menuLabel": "Add Text Input Object From The Web",
                            "successMessage": "Adding Text Input Object"
                        },
                        {
                            "fileName": "database.py",
                            "menuLabel": "Add DB Objects From The Web",
                            "successMessage": "Adding Database Object"
                        },
                        {
                            "fileName": "checkbox.py",
                            "menuLabel": "Add CheckBox and Radio Buttons From The Web",
                            "successMessage": "Adding CheckBox Object"
                        },
                        {
                            "fileName": "text_files.py",
                            "menuLabel": "Add Text File From The Web",
                            "successMessage": "Adding Text File Object"
                        }
                    ],
                    "description": "Download entries shown in PyGame: Show Menu. Each entry can optionally provide a url to override pygameObjects.baseUrl + fileName.",
                    "scope": "application",
                    "items": {
                        "type": "object",
                        "required": [
                            "fileName"
                        ],
                        "properties": {
                            "fileName": {
                                "type": "string",
                                "description": "File name to download, e.g. buttons.py"
                            },
                            "url": {
                                "type": "string",
                                "description": "Optional full http/https URL. When set, overrides pygameObjects.baseUrl + fileName."
                            },
                            "menuLabel": {
                                "type": "string",
                                "description": "Label shown in the PyGame menu for this entry."
                            },
                            "successMessage": {
                                "type": "string",
                                "description": "Message shown after a successful download."
                            }
                        }
                    }
                }
            }
        }
    },
    "files": [
        "extension.js",
        "src/"
    ],
    "scripts": {
        "package": "vsce package",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mathew-D/vs_code_pygame"
    },
    "keywords": [
        "vscode",
        "extension",
        "python",
        "pygame"
    ],
    "author": "Mathew Dusome",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.5.4"
    }
}